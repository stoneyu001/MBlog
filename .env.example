# ============================================
# MBlog 环境变量配置模板
# ============================================
# 
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改下面的配置值（特别是数据库密码）
# 3. 确保 .env 文件已添加到 .gitignore
#
# 重要提示：
# - 生产环境请使用强密码
# - 不要将 .env 文件提交到版本控制系统
# ============================================

# --------------------------------------------
# 端口配置
# --------------------------------------------
# 前端服务端口（Nginx）
# 注意：如果宿主机使用 Nginx 处理 SSL，请将此端口改为 8080
# 避免与宿主机 Nginx 的 80 端口冲突
FRONTEND_PORT=8080

# 后端服务端口（Go API）
BACKEND_PORT=3000

# 数据库端口（PostgreSQL）
DB_PORT=5432

# --------------------------------------------
# 数据库配置
# --------------------------------------------
# PostgreSQL 用户名
POSTGRES_USER=postgres

# PostgreSQL 密码（请修改为强密码！）
POSTGRES_PASSWORD=your_secure_password_here

# PostgreSQL 数据库名
POSTGRES_DB=blog_db

# --------------------------------------------
# 域名配置（部署脚本使用）
# --------------------------------------------
# 网站域名
DOMAIN=www.stoneyu.fun

# Certbot 邮箱（用于 SSL 证书申请通知）
CERTBOT_EMAIL=2065802923@qq.com

# --------------------------------------------
# 管理员认证配置
# --------------------------------------------
# 管理员用户名
ADMIN_USER=admin

# 管理员密码（至少 12 个字符，不能使用默认密码）
ADMIN_PASSWORD=replace_with_a_strong_password

# JWT 签名密钥（至少 32 个随机字符）
JWT_SECRET=replace_with_at_least_32_random_characters

# HTTPS 部署保持 true；仅本机 HTTP 开发时设为 false
COOKIE_SECURE=true

# Gin 仅信任本机和 Docker 默认私网中的反向代理；多个值用英文逗号分隔
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
